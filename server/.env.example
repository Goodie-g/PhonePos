# Copy to .env and fill in. NEVER commit .env.
# PostgreSQL connection string
DATABASE_URL="postgresql://stoku:stoku@localhost:5433/stoku?schema=public"

# JWT signing secret — use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET="replace-with-a-long-random-string"

# Access token lifetime (short-lived; clients use the refresh token to renew)
JWT_ACCESS_TTL="15m"

# Refresh token lifetime in days (rotating; stored hashed server-side)
REFRESH_TOKEN_TTL_DAYS=30

# HTTP port for the API
PORT=4000

# Comma-separated list of allowed CORS origins (the Expo web dev URL, your deployed app, ...)
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Set to "production" in deployed environments
NODE_ENV=development
