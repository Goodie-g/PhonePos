{
  "name": "stoku-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stoku API — wholesale & distribution management for mobile-phone businesses",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "db:reset": "node prisma/reset.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "supertest": "^7.0.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
